# Local environment for the host-run frontend (ADR-0014, ADR-0016).
# `mise run dev:frontend` already sets both vars below, so this file is only
# needed if you start `next dev` some other way (an IDE run config, a debugger).
# Copy to .env.local — Next loads it before evaluating next.config.mjs.
#
# Prereqs (the edge, Kratos and the services all live in the cluster):
#   mise run cluster:full    # the full local platform, real services
#   mise run cluster:edge    # OR: real edge + real Kratos, mocked data (ADR-0029)
#   then log in at https://dev.localtest.me:8443/ — cluster:edge seeds the
#   committed test identities (e2e/fixtures/identities.ts); on cluster:full,
#   register at /auth/register or run `mise run auth:seed`.
#
# There is deliberately NO development-auth variable. The frontend has one
# authentication path and it is the production one (ADR-0029); the way to be
# logged in locally is to be logged in. `mise run lint:auth-inline` enforces it.

# The environment's edge origin — the single URL this app is configured with.
#   • server components fetch through it (src/lib/server-fetch/server.ts): the
#     /api/<resource> IngressRoutes match on Host(dev.localtest.me) and Oathkeeper
#     injects identity there, so requests go to the edge, never to a service or a
#     cluster-internal address. Unset, /panel/products throws on its first fetch.
#   • next.config.mjs derives the server-action CSRF allowlist from it.
# Browser-side calls need nothing: client.ts uses a relative /api (ADR-0017).
EDGE_ORIGIN=https://dev.localtest.me:8443

# Local-only. The wildcard cert comes from the SelfSigned ClusterIssuer — a
# self-signed leaf, not a CA — so Node cannot be taught to trust it with
# NODE_EXTRA_CA_CERTS, and the server-side fetch above would fail the handshake.
# Deployed envs have Let's Encrypt certs and set neither this nor a CA bundle.
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Standalone mock — logged-out surfaces only (mise run mock:start) ───────────
# No cluster and no auth stack: the mock alone, on the host, serving the committed
# OpenAPI projection (ADR-0029). Set this and EDGE_ORIGIN above is not needed —
# both the server-side client and the browser's same-origin /api calls are pointed
# at the mock (next.config.mjs rewrites /api/* through to it).
#
# For landing pages and other surfaces with nothing to authenticate. Anything
# behind a session redirects to a login page that is not running — that needs the
# real edge: mise run cluster:edge.
#
# MOCK_API_ORIGIN=http://127.0.0.1:4010

# Build identity (ADR-0013). CI passes the git SHA / release; locally the
# defaults in next.config.mjs ("dev") are fine.
# SERVICE_VERSION=dev
# DEPLOY_ENV=dev

# Browser RUM beacons (ADR-0011). With the full tier up and `mise run dev:forward`
# running, uncomment to forward Faro beacons to the cluster's OTel Collector;
# unset, the dev-only /api/rum handler returns 204 and drops them.
# FARO_COLLECT_URL=http://localhost:12347/collect
