{
  "title": "Overview",
  "uid": "overview",
  "schemaVersion": 39,
  "tags": ["overview", "landing", "slo"],
  "description": "L1 landing page (ADR-0026): answers 'is anything wrong right now, and where?' and nothing else. Every panel either turns red or links down a level — firing alerts, cluster-wide golden signals, per-service SLO status (linking to Service detail), and one-line health for the platform dependencies (linking to Platform components / Network: policy denials). Deep-dive timeseries live one click down; if a panel here cannot demand action, it does not belong here. The Applications dashboard remains the full workload directory (every pod, incl. idle ones).",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Is anything wrong?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Firing alerts",
      "description": "Count of Prometheus alerts currently firing (alerts-as-code, infra/observability/alerts). Anything non-zero: see the table below.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "Total req/s",
      "description": "Cluster-wide HTTP request rate across all instrumented services.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count[5m])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "description": "Cluster-wide share of HTTP responses that are 5xx.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count[5m]))) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "Cluster-wide HTTP p95 across all instrumented services.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "Pods not ready",
      "description": "Pods that are not Running and not Succeeded (Pending / Failed / Unknown), cluster-wide.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "(count(k8s_pod_phase != 3) - count(k8s_pod_phase == 2)) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "Policy drops/s",
      "description": "NetworkPolicy denials (hubble_drop_total, reason=POLICY_DENIED). Non-zero means a policy is blocking a flow someone expected to work — click through for history by reason and flow. Scoped to POLICY_DENIED on purpose: unfiltered, this tile also counts UNSUPPORTED_L3_PROTOCOL, which on an IPv4-only dataplane is constant benign background (see the reason breakdown on the linked dashboard) and pinned the tile red permanently.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 6
      },
      "links": [
        {
          "title": "Network: policy denials",
          "url": "/d/hubble-drops/network-policy-denials"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hubble_drop_total{reason=\"POLICY_DENIED\"}[5m])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "table",
      "title": "Firing alerts — what and where",
      "description": "One row per firing Prometheus alert. severity=page means act now; severity=ticket means file and fix in hours. Rules live in infra/observability/alerts/.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "ALERTS{alertstate=\"firing\"}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "service_name": 2,
              "service_namespace": 3
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "service_name": "Service",
              "service_namespace": "Namespace"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "page": {
                        "color": "red",
                        "index": 0
                      },
                      "ticket": {
                        "color": "yellow",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Services — SLO status",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "HTTP services — click a name to open its detail page",
      "description": "SLO status per HTTP-serving service over the selected time range, same expressions as the Service detail SLO tiles (99.9% availability target). Only services with recent HTTP traffic appear here — the full workload directory (incl. idle and non-HTTP pods) is the Applications dashboard.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "links": [
        {
          "title": "Applications — all workloads",
          "url": "/d/applications/applications"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "100 * (1 - ((sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__range])) or (sum by (service_name) (rate(http_server_request_duration_seconds_count[$__range])) * 0)) / sum by (service_name) (rate(http_server_request_duration_seconds_count[$__range]))))"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "100 * (1 - (((sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__range])) or (sum by (service_name) (rate(http_server_request_duration_seconds_count[$__range])) * 0)) / sum by (service_name) (rate(http_server_request_duration_seconds_count[$__range]))) / 0.001))"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count[$__range]))"
        },
        {
          "refId": "D",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__range])) or (sum by (service_name) (rate(http_server_request_duration_seconds_count[$__range])) * 0)"
        },
        {
          "refId": "E",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket[$__range])))"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "service_name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true
            },
            "renameByName": {
              "service_name": "Service",
              "Value #A": "Availability",
              "Value #B": "Error budget left (99.9%)",
              "Value #C": "Req/s",
              "Value #D": "Errors/s",
              "Value #E": "p95 latency"
            },
            "indexByName": {
              "service_name": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Error budget left (99.9%)",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open service detail",
                    "url": "/d/service-detail/service-detail?var-service=${__data.fields.Service}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Availability"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 99
                    },
                    {
                      "color": "green",
                      "value": 99.9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error budget left (99.9%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0
                    },
                    {
                      "color": "green",
                      "value": 50
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Req/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Errors/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 latency"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Platform dependencies",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Postgres txn/s",
      "description": "Commits + rollbacks across all databases (CNPG exporter). Click through for per-database breakdowns.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 27
      },
      "links": [
        {
          "title": "Platform components",
          "url": "/d/platform-components/platform-components"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cnpg_pg_stat_database_xact_commit_total{service_name=\"postgres\"}[5m]) + rate(cnpg_pg_stat_database_xact_rollback_total{service_name=\"postgres\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "down?"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "Postgres backends",
      "description": "Open connections across all databases. Sudden jumps usually mean a connection-pool leak.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 27
      },
      "links": [
        {
          "title": "Platform components",
          "url": "/d/platform-components/platform-components"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cnpg_backends_total{service_name=\"postgres\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "down?"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "Temporal frontend p95",
      "description": "gRPC latency p95 at the Temporal frontend, excluding long-poll operations (which block ~60s by design). Click through for role/persistence breakdowns.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 27
      },
      "links": [
        {
          "title": "Platform components",
          "url": "/d/platform-components/platform-components"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(service_latency_bucket{service_name=\"temporal\",type=\"frontend\",operation!~\"PollWorkflowTaskQueue|PollActivityTaskQueue|PollNexusTaskQueue|GetWorkflowExecutionHistory\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "idle",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "Temporal schedule→start p95",
      "description": "Task schedule-to-start p95 — the queue-backlog signal. Rising means workers cannot keep up.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 27
      },
      "links": [
        {
          "title": "Platform components",
          "url": "/d/platform-components/platform-components"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(task_schedule_to_start_latency_bucket{service_name=\"temporal\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "idle",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "row",
      "title": "Capacity — is the cluster running out?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Node CPU used",
      "description": "Real CPU saturation across nodes. Read together with 'CPU requests committed': this can sit near zero while the scheduler is already full.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(k8s_node_cpu_usage) / sum(k8s_node_allocatable_cpu)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "Node memory used",
      "description": "Real memory saturation. Above ~90% the next allocation spike OOM-kills a container that is over its request.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(k8s_node_memory_available_bytes) / (sum(k8s_node_memory_available_bytes) + sum(k8s_node_memory_usage_bytes)))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
