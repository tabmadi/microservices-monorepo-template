    {
      "type": "stat",
      "title": "Node disk free",
      "description": "Free space on the node filesystem — the disk kubelet evicts on. This cluster pins eviction-hard at 2% so kubelet gives almost no warning of its own; treat anything under 15% as the warning. Reclaim with docker/crictl image + build-cache pruning and a registry garbage-collect.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(k8s_node_filesystem_available_bytes) / sum(k8s_node_filesystem_capacity_bytes)"
